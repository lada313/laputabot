# Configure in the hosting secret/environment settings; this file is not auto-loaded.
TELEGRAM_TOKEN=
TINKOFF_TOKEN=
# Numeric Telegram user IDs, not usernames; private chats only.
ALLOWED_USER_IDS=
# Notification destination must be one of ALLOWED_USER_IDS.
CHAT_ID=
# Set an absolute path on a persistent private volume.
DATA_DIR=
# Private data is NEVER synchronized to Git, even if this is enabled.
GIT_SYNC=0
# Optional public catalog sync only, via credential helper or SSH agent.
GIT_REPO=https://github.com/lada313/laputabot.git
